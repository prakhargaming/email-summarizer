# Transaction pooler URL, with the psycopg driver prefix.
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres
# Same OAuth client as NextAuth on Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
ALLOWED_EMAILS=someone@example.com
ENV=dev
# Shared with the Next.js proxy (web API_SIGNING_SECRET): python -c "import secrets;print(secrets.token_urlsafe(48))"
API_SIGNING_SECRET=
# Dev only (requires ENV=dev): used when a request carries no token (curl, scripts).
DEV_USER_EMAIL=someone@example.com
# ngrok AI Gateway access key; unset LLM_BASE_URL to call Gemini directly with GEMINI_API_KEY.
LLM_BASE_URL=https://gateway.ngrok.ai
LLM_API_KEY=
GEMINI_API_KEY=
# A Flash-tier model name from https://app.ngrok.ai/models
LLM_MODEL=
