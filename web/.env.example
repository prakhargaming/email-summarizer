# Copy to .env.local for `next dev`; set the same names in Vercel (Production) for the deploy.
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
# The same Google OAuth client as the backend (refresh tokens are tied to it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FastAPI. Production: https://triage-api.prakhargaming.com
API_URL=http://localhost:8000
# Must equal the backend's API_SIGNING_SECRET.
API_SIGNING_SECRET=
# Public key from the same VAPID key pair that the backend uses.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
